{
  "name": "@ahoi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Healthcare Operational Intelligence Accelerator API",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
