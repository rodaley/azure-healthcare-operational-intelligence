{
  "name": "azure-healthcare-operational-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "Azure Healthcare Operational Intelligence Accelerator monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
